# Example environment. Copy it to .env (git-ignored) and fill in what you need.
#
#   cp .env.example .env
#
# Who reads it:
#   - local development and tests need NOTHING from here: config.settings.local is hard-coded
#     (SQLite, DEBUG on). To point a local run at a real api-ocpp, export the api-ocpp block:
#       set -a; . ./.env; set +a; python manage.py runserver
#   - docker compose reads .env by itself for the ${...} values in docker-compose.yml.
#   - deployed environments get these from Terraform (deploy/terraform/containerapps.tf), never
#     from a file: the production block documents what config.settings.production expects.

# --- api-ocpp (local and compose) ----------------------------------------------------------------
# A READ-ONLY database user on an environment's api-ocpp Postgres (SELECT on every tenant schema).
OCPP_DATABASE_URL=postgres://readonly:password@localhost:5432/ocpp
# api-ocpp's tenant schemas (its TENANT_SCHEMAS), comma-separated.
OCPP_TENANTS=public,eosgie
# api-gateway's and api-gireve's databases, READ-ONLY users; unset: local SQLite files (empty).
# GATEWAY_DATABASE_URL=postgres://readonly:password@localhost:5432/gateway
# GIREVE_DATABASE_URL=postgres://readonly:password@localhost:5432/gireve

# --- Production (config.settings.production; set by Terraform) ------------------------------------
# Uncomment to run the production settings by hand, e.g.
#   DJANGO_SETTINGS_MODULE=config.settings.production python manage.py check --deploy

# Required
# SECRET_KEY=change-me-50-random-characters
# DJANGO_ALLOWED_HOSTS=diagnostics.swish.example
# This app's own Postgres: cases and support users.
# DATABASE_URL=postgres://swishdiag:password@localhost:5432/swishdiag
# Shared with the auth proxy, which sends it as X-Proxy-Secret with the identity headers.
# AUTH_PROXY_SECRET=change-me

# Optional
# DJANGO_CSRF_TRUSTED_ORIGINS=https://diagnostics.swish.example
# The user service's groups that grant each role (config/roles.py)
# AUTH_PROXY_DATA_GROUPS=swish-data,swish-ops
# AUTH_PROXY_SUPPORT_GROUPS=swish-support,swish-ops
# AUTH_PROXY_USER_HEADER=X-Forwarded-User
# AUTH_PROXY_GROUPS_HEADER=X-Forwarded-Groups
# AUTH_PROXY_SECRET_HEADER=X-Proxy-Secret
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.05
# ENVIRONMENT=staging
# IMAGE_TAG=v1.0.0
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# --- Deployments page (also read locally when exported) -------------------------------------------
# GitHub: read access to Actions and contents of the service repos.
# GITHUB_TOKEN=
# Kubeconfig file per cluster; a cluster without one shows as "unknown".
# KUBECONFIG_STAGING=/path/to/kubeconfig-staging
# KUBECONFIG_PRODUCTION=/path/to/kubeconfig-production
# KUBECONFIG_CSMS_PRODUCTION=/path/to/kubeconfig-csms-production
# DEPLOYMENT_STATUS_CACHE_SECONDS=60

# --- Claude's assessment and the Jira escalation of a case (also read locally when exported) -----
# Without the key there is no "Ask Claude" button; without the Jira account, no "Create the Jira
# ticket" button. The defaults are in config/settings/base.py.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_URL=https://swishforgood.atlassian.net
# JIRA_PROJECT=ROT
# JIRA_ISSUE_TYPE=[System] Incident
# JIRA_LABELS=jira_escalated,support-diagnostics

# --- The image's entrypoint (docker/entrypoint.sh) -------------------------------------------------
# PORT=8000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=8
