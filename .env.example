SECRET_KEY=change-me
DEBUG=true
ENVIRONMENT=local
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# This app's own database (support users, sessions). SQLite in the project dir if unset.
DATABASE_URL=

# api-ocpp database. Use a read-only database user in production.
OCPP_DATABASE_URL=postgres://readonly:password@localhost:5432/ocpp
# api-ocpp Postgres schemas, one per tenant (same values as api-ocpp's TENANT_SCHEMAS).
OCPP_TENANTS=public

SENTRY_DSN=
