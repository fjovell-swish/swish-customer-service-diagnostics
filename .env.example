# Local development reads nothing from here by itself: export what you need, e.g.
#   set -a; . ./.env; set +a
# Deployed environments get their variables from Terraform (deploy/terraform/containerapps.tf);
# the full list is at the top of config/settings/production.py.

# Optional locally: an environment's api-ocpp, through a READ-ONLY user.
OCPP_DATABASE_URL=postgres://readonly:password@localhost:5432/ocpp
# api-ocpp's tenant schemas (its TENANT_SCHEMAS), comma-separated.
OCPP_TENANTS=public,eosgie
